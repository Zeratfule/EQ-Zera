/**
 * gen-quest-steps-changed.mts — writes src/shared/questStepsChanged.json: for every quest whose steps
 * MOVED between some release since the quest tracker shipped (v1.19.0) and the quests.json on disk,
 * the NEWEST such release.
 *
 *   npm run gen:quest-steps-changed
 *
 * THE ONE COMMAND after any change to quests.json's steps. `npm run refresh:data` runs it for you on
 * a quests step that passed its health gate; a test (tests/questStepsSig.test.mts, "NOT STALE") fails
 * if quests.json's steps no longer match the digest this file was generated from, so it cannot be
 * forgotten. Commit the JSON with the quests.json it describes.
 *
 * "Moved" is the tick reconcile's own test (src/shared/questStepsSig.ts): the step count differs, or
 * some step's normalised meaning differs at its index. An unsigned tracker pin (stored before step
 * keys) loses a quest's hand ticks when that quest moved at or after the release the player last ran.
 *
 * Reads git history (`git show vX:…quests.json`), so it needs the full clone with tags. Offline.
 */
import { execFileSync } from 'node:child_process'
import { readFileSync, writeFileSync } from 'node:fs'
import { join, resolve } from 'node:path'
import { pathToFileURL } from 'node:url'
import type { QuestData } from '../src/shared/types'
import { normaliseStep, questStepsDigest } from '../src/shared/questStepsSig'

const ROOT = join(import.meta.dirname, '..')
const QUESTS = 'src/renderer/src/data/eqlegends/quests.json'
const OUT = join(ROOT, 'src', 'shared', 'questStepsChanged.json')
/** The release that shipped the quest tracker (shared/questPins.ts first appears in it). */
const FIRST = [1, 19, 0]

const git = (...args: string[]): string => execFileSync('git', args, { cwd: ROOT, encoding: 'utf8', maxBuffer: 1 << 28 })

const version = (tag: string): number[] => tag.slice(1).split('.').map(Number)
const atLeast = (v: number[], min: number[]): boolean => {
  for (let i = 0; i < min.length; i++) if ((v[i] ?? 0) !== min[i]) return (v[i] ?? 0) > min[i]
  return true
}

/** Did this quest's steps move between `before` and `now`? */
function moved(before: readonly string[], now: readonly string[]): boolean {
  if (before.length !== now.length) return true
  return before.some((s, i) => normaliseStep(s) !== normaliseStep(now[i]))
}

/** Every release tag since the tracker, oldest first. */
function releaseTags(): string[] {
  return git('tag', '--list', 'v*')
    .split('\n')
    .map((t) => t.trim())
    .filter((t) => /^v\d+\.\d+\.\d+$/.test(t) && atLeast(version(t), FIRST))
    .sort((a, b) => {
      const [x, y] = [version(a), version(b)]
      return x[0] - y[0] || x[1] - y[1] || x[2] - y[2]
    })
}

/** Write the file; returns a one-line summary. */
export function generateQuestStepsChanged(): string {
  const quests = (JSON.parse(readFileSync(join(ROOT, QUESTS), 'utf8')) as QuestData).quests
  const now = new Map(quests.map((q) => [q.page, q.steps ?? []]))
  const tags = releaseTags()
  const newest = new Map<string, string>()
  for (const tag of tags) {
    const old = (JSON.parse(git('show', `${tag}:${QUESTS}`)) as QuestData).quests
    for (const q of old) {
      const current = now.get(q.page)
      // Oldest first, so the last write is the newest release that differs.
      if (current !== undefined && moved(q.steps ?? [], current)) newest.set(q.page, tag.slice(1))
    }
  }
  const out = {
    about: 'Per quest whose steps moved, the newest release since v1.19.0 whose steps for it differ from this build. Generated by `npm run gen:quest-steps-changed`; read by src/shared/questStepsSig.ts.',
    stepsDigest: questStepsDigest(quests),
    releases: tags,
    moved: Object.fromEntries([...newest].sort((a, b) => a[0].localeCompare(b[0], 'en')))
  }
  writeFileSync(OUT, `${JSON.stringify(out, null, 2)}\n`)
  return `gen:quest-steps-changed - ${String(tags.length)} releases (${tags[0] ?? '-'} .. ${tags[tags.length - 1] ?? '-'}); ${String(newest.size)} quests whose steps moved -> ${OUT}`
}

if (process.argv[1] !== undefined && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
  console.log(generateQuestStepsChanged())
}
