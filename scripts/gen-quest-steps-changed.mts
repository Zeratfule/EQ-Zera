/**
 * gen-quest-steps-changed.mts — writes src/shared/questStepsChanged.json: every quest whose steps
 * MOVED between any release since the quest tracker shipped (v1.19.0) and the quests.json on disk.
 *
 *   node --import tsx scripts/gen-quest-steps-changed.mts
 *
 * "Moved" is the tick reconcile's own test (src/shared/questStepsSig.ts): the step count differs, or
 * some step's normalised meaning differs at its index. A tracker pin stored before step keys could
 * have been ticked on ANY of those releases, so an unsigned pin on a listed quest loses its hand
 * ticks. Re-run whenever quests.json changes in a release (and commit the result with it).
 *
 * Reads git history (`git show vX:…quests.json`), so it needs the full clone with tags. Offline.
 */
import { execFileSync } from 'node:child_process'
import { readFileSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'
import type { QuestData } from '../src/shared/types'
import { normaliseStep } from '../src/shared/questStepsSig'

const ROOT = join(import.meta.dirname, '..')
const QUESTS = 'src/renderer/src/data/eqlegends/quests.json'
const OUT = join(ROOT, 'src', 'shared', 'questStepsChanged.json')
/** The release that shipped the quest tracker (shared/questPins.ts first appears in it). */
const FIRST = [1, 19, 0]

const git = (...args: string[]): string => execFileSync('git', args, { cwd: ROOT, encoding: 'utf8', maxBuffer: 1 << 28 })

const version = (tag: string): number[] => tag.slice(1).split('.').map(Number)
const atLeast = (v: number[], min: number[]): boolean => {
  for (let i = 0; i < min.length; i++) if ((v[i] ?? 0) !== min[i]) return (v[i] ?? 0) > min[i]
  return true
}

/** Did this quest's steps move between `before` and `now`? */
function moved(before: readonly string[], now: readonly string[]): boolean {
  if (before.length !== now.length) return true
  return before.some((s, i) => normaliseStep(s) !== normaliseStep(now[i]))
}

const now = new Map((JSON.parse(readFileSync(join(ROOT, QUESTS), 'utf8')) as QuestData).quests.map((q) => [q.page, q.steps ?? []]))
const tags = git('tag', '--list', 'v*')
  .split('\n')
  .map((t) => t.trim())
  .filter((t) => /^v\d+\.\d+\.\d+$/.test(t) && atLeast(version(t), FIRST))
  .sort((a, b) => {
    const [x, y] = [version(a), version(b)]
    return x[0] - y[0] || x[1] - y[1] || x[2] - y[2]
  })
const pages = new Set<string>()
for (const tag of tags) {
  const old = (JSON.parse(git('show', `${tag}:${QUESTS}`)) as QuestData).quests
  for (const q of old) {
    const current = now.get(q.page)
    if (current !== undefined && moved(q.steps ?? [], current)) pages.add(q.page)
  }
}
const out = {
  about: 'Quests whose steps moved between a release since v1.19.0 and this build. Generated by scripts/gen-quest-steps-changed.mts; read by src/shared/questStepsSig.ts.',
  releases: tags,
  pages: [...pages].sort((a, b) => a.localeCompare(b, 'en'))
}
writeFileSync(OUT, `${JSON.stringify(out, null, 2)}\n`)
console.log(`${String(tags.length)} releases (${tags[0] ?? '-'} .. ${tags[tags.length - 1] ?? '-'}); ${String(pages.size)} quests whose steps moved -> ${OUT}`)
